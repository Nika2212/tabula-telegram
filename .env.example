# --- Source -----------------------------------------------------------------
# The public Next.js page; its __NEXT_DATA__ carries the same JSON:API payload
# as api.tabula.ge, which is unreachable behind a Cloudflare challenge.
SOURCE_BASE_URL=https://tabula.ge
SOURCE_LIST_PATH=/ge/news

# --- Polling ----------------------------------------------------------------
POLL_INTERVAL_MS=120000
# Safety cap after an outage, so a restart cannot flood the channel.
MAX_ITEMS_PER_RUN=10
STATE_PATH=./data/state.json

# --- HTTP -------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=1000
# Leave unset to use the bundled browser user agent; a non-browser UA is
# challenged by Cloudflare.
# REQUEST_USER_AGENT=

# --- Telegram (console-only while token or channel is unset) -----------------
TELEGRAM_BOT_TOKEN=
# @channelusername for a public channel, or -100... for a private one
TELEGRAM_CHANNEL_ID=
# Format and log posts without calling the Bot API.
TELEGRAM_DRY_RUN=false
# Spacing between sends; channels allow roughly 20 messages/minute.
TELEGRAM_MIN_INTERVAL_MS=3500
TELEGRAM_DISABLE_NOTIFICATION=false

# debug | info | warn | error
LOG_LEVEL=info
