# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Target channel: numeric id (-100...) or @channelusername
TELEGRAM_CHANNEL_ID=

# Pipeline
POLL_INTERVAL_MS=300000
DRY_RUN=false

# HTTP
REQUEST_TIMEOUT_MS=15000
REQUEST_USER_AGENT=tabula-telegram/0.1.0

# State
SEEN_STORE_PATH=./data/seen.json

# debug | info | warn | error
LOG_LEVEL=info
